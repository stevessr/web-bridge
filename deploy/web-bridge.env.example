# Public listener. Prefer loopback when using Caddy/Nginx on the same host.
WEB_BRIDGE_HOST=127.0.0.1
WEB_BRIDGE_PORT=8080

# REQUIRED when the bridge is reachable by anyone other than the local user.
# Browser authentication uses HTTP Basic; the username may be anything and this token is the password.
WEB_BRIDGE_AUTH_TOKEN=replace-with-a-long-random-token

# Keep CDP private. The launcher chooses a random loopback port when this is omitted.
WEB_BRIDGE_CDP_HOST=127.0.0.1
# WEB_BRIDGE_CDP_PORT=9222

# Optional tuning.
WEB_BRIDGE_MAX_CLIENTS=4
WEB_BRIDGE_INPUT_EVENTS_PER_SECOND=180
WEB_BRIDGE_CONTROL_LEASE_MS=30000
WEB_BRIDGE_MAX_RESOURCE_BYTES=67108864
WEB_BRIDGE_RESOURCE_CACHE_BYTES=201326592
WEB_BRIDGE_MAX_UPLOAD_BYTES=268435456
WEB_BRIDGE_FULL_SNAPSHOT_INTERVAL_MS=60000
# WEB_BRIDGE_TARGET_MATCH=QQ
