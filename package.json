{
  "name": "qqnt-web-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DOM-reconstruction web bridge for QQ NT and closed-source Electron apps",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/host.mjs",
    "start": "node src/host.mjs",
    "dev:qq": "bash scripts/qq-web-bridge.sh",
    "detect:qq": "node src/qq-detect.mjs --all",
    "media": "node src/media/cli.mjs run",
    "media:once": "node src/media/cli.mjs once",
    "media:doctor": "node src/media/cli.mjs doctor",
    "media:state": "node src/media/cli.mjs state",
    "media:web": "node src/media/web.mjs",
    "media:web:dev": "node --watch src/media/web.mjs",
    "test": "node --test",
    "doctor": "node src/doctor.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  }
}
